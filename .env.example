# Reference only: forte does not automatically load dotenv files.
# Export these variables or use your service manager; keep secrets outside Git.
FORTE_API_KEY_FILE=/absolute/private/service-api.key
FORTE_PRIVATE_ROOT=/absolute/private/jobs
FORTE_MODEL_URL=http://127.0.0.1:8001
FORTE_MODEL_NAME=forte-vlm
FORTE_MODEL_REVISION=0c351dd01ed87e9c1b53cbc748cba10e6187ff3b
FORTE_MAX_CONTEXT_TOKENS=8192
FORTE_V1_PIPELINE=legacy
# Optional explicit frozen reasoning configuration with actual mounted paths:
# FORTE_REASONING_CONFIG=/absolute/private/frozen-inference.json
# Optional built interface; real browser access still requires the session gateway:
# FORTE_FRONTEND_ROOT=/absolute/checkout/web/out
# Optional separate trusted-gateway token, never the service key:
# FORTE_TRUSTED_GATEWAY_TOKEN_FILE=/absolute/private/gateway-token
# Container entrypoint additionally requires FORTE_MODEL_PATH and selects:
# FORTE_MODEL_PROFILE=baseline8b
# Dataset command uses --archive explicitly; data stays outside Git.
